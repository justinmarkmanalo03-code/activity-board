# Supabase project credentials (Settings -> API in your Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only: needed for admin password resets (Settings -> API -> service_role)
# NEVER prefix this with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
